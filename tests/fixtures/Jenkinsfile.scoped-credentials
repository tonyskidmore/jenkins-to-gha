pipeline {
  agent any
  parameters { string(name: 'TAG_NAME', defaultValue: '') }
  environment {
    CRED = 'outer-id'
    LIT = 'lit-id'
  }
  stages {
    stage('Inner') {
      environment { CRED = 'inner-id' }
      steps {
        withCredentials([string(credentialsId: "${env.CRED}", variable: 'TOKEN')]) { sh 'test -n "$TOKEN"' }
        echo "tag=<${TAG_NAME}> env=<${env.TAG_NAME}> params=<${params.TAG_NAME}>"
      }
    }
    stage('Outer') {
      steps {
        withCredentials([string(credentialsId: "${CRED}", variable: 'TOKEN')]) { sh 'test -n "$TOKEN"' }
        withEnv(['CRED=with-env-id']) {
          withCredentials([string(credentialsId: "${env.CRED}", variable: 'TOKEN')]) { sh 'test -n "$TOKEN"' }
        }
        withCredentials([string(credentialsId: 'lit-id', variable: 'A'), string(credentialsId: "${LIT}", variable: 'B')]) {
          sh 'test -n "$A$B"'
        }
      }
    }
    stage('Dynamic') {
      environment { CRED = "${BUILD_NUMBER}-id" }
      steps {
        withCredentials([string(credentialsId: "${env.CRED}", variable: 'TOKEN')]) { sh 'test -n "$TOKEN"' }
      }
    }
  }
}
