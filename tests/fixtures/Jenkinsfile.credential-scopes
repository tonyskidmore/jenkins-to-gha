pipeline {
  agent any
  options { skipDefaultCheckout() }
  environment {
    CRED = 'outer-id'
    DYN = "${BUILD_NUMBER}-dyn"
  }
  stages {
    stage('Sibling') {
      steps {
        withEnv(['CRED=sibling-id']) { echo 'inside' }; withCredentials([string(credentialsId: "${env.CRED}", variable: 'TOKEN')]) { sh 'test -n "$TOKEN"' }
      }
    }
    stage('Nested') {
      steps {
        withEnv(['CRED=middle-id']) { withEnv(['CRED=nested-id']) { withCredentials([string(credentialsId: "${env.CRED}", variable: 'TOKEN')]) { sh 'test -n "$TOKEN"' } } }
      }
    }
    stage('LiteralOverDynamic') {
      steps {
        withEnv(["CRED=${env.BUILD_NUMBER}-id"]) {
          withEnv(['CRED=literal-id']) {
            withCredentials([string(credentialsId: "${env.CRED}", variable: 'TOKEN')]) { sh 'test "$CRED" = literal-id' }
          }
          sh 'echo "cred=$CRED"'
        }
      }
    }
    stage('DynamicOverLiteral') {
      steps {
        withEnv(['CRED=shadowed-id']) {
          withEnv(["CRED=${env.BUILD_NUMBER}-id"]) {
            withCredentials([string(credentialsId: "${env.CRED}", variable: 'TOKEN')]) { sh 'test -n "$TOKEN"' }
          }
        }
      }
    }
    stage('StageOverPipelineExport') {
      environment { DYN = 'stage-dyn-id' }
      steps {
        withCredentials([string(credentialsId: "${env.DYN}", variable: 'TOKEN')]) { sh 'test "$DYN" = stage-dyn-id' }
      }
    }
    stage('Ma') { matrix { axes { axis { name 'PLATFORM'; values 'linux' } }; environment { CRED = 'matrix-a-id' }; stages { stage('Usea') { steps { withCredentials([string(credentialsId: "${env.CRED}", variable: 'TOKEN')]) { sh 'test "$CRED" = matrix-a-id' } } } } } }; stage('Mb') { matrix { axes { axis { name 'PLATFORM'; values 'linux' } }; environment { CRED = 'matrix-b-id' }; stages { stage('Useb') { steps { withCredentials([string(credentialsId: "${env.CRED}", variable: 'TOKEN')]) { sh 'test "$CRED" = matrix-b-id' } } } } } }
  }
}
