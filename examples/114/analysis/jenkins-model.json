                      "key": "scriptBlock",
                      "value": {
                        "isLiteral": true,
                        "value": "retry(3) {\n                        try {\n                            sh 'PDK_ROOT=$(pwd)/pdks OPENLANE_IMAGE_NAME=efabless/openlane python3 .github/scripts/update_tools.py openroad_app';\n                            sh 'echo make -C docker build-openroad_app'; // j2gha-local: builds the OpenROAD image (multi-GB, hours); no Docker daemon in the harness\n                            script { NEW_SHA  = sh (returnStdout: true, script: \"python3 dependencies/tool.py -f commit openroad_app\").trim(); }\n                            sh 'echo make -C docker openlane OPENLANE_IMAGE_NAME=current:latest'; // j2gha-local: builds the OpenLane image; no Docker daemon in the harness\n                            sh 'echo \"docker save current:latest-amd64 (j2gha-local stand-in for the image)\" | gzip > openlane-current.tar.gz'; // j2gha-local: no image to save; a small gzip keeps the stash/unstash of openlane-current.tar.gz real\n                            stash name: 'data', includes: 'openlane-current.tar.gz';\n                        }\n                        catch (e) {\n                            sleep(60);\n                            sh 'exit 1';\n                        }\n                    }"
                      }
                    }
