                            "key": "scriptBlock",
                            "value": {
                              "isLiteral": true,
                              "value": "stage(\"${DESIGN} - Install PDK\") {\n                                    sh 'echo python3 -m pip install --user --upgrade --no-cache-dir pip'; // j2gha-local: pip into the system Python is refused on Debian 13 (PEP 668)\n                                    sh 'echo python3 -m pip install --user --upgrade --no-cache-dir volare'; // j2gha-local: same; volare is only needed by the real make pdk\n                                    sh 'echo make pdk'; // j2gha-local: downloads a PDK (GB) through volare\n                                }\n                                stage(\"${DESIGN} - Import Docker image\") {\n                                    unstash \"data\";\n                                    sh 'echo docker load --input openlane-current.tar.gz && gzip -dc openlane-current.tar.gz'; // j2gha-local: no Docker daemon; decompressing the unstashed file proves it arrived intact\n                                }\n                                stage(\"${DESIGN} - Update OpenROAD commit\") {\n                                    script { OLD_SHA  = sh (returnStdout: true, script: \"python3 dependencies/tool.py -f commit openroad_app\").trim(); }\n                                    sh \"sed -i s/${OLD_SHA}/${NEW_SHA}/ ./dependencies/tool_metadata.yml\"\n                                }\n                                stage(\"${DESIGN} - Run test\") {\n                                    sh \"echo make OPENLANE_IMAGE_NAME=current:latest TEST_DESIGN=${DESIGN} test\"; // j2gha-local: runs the RTL-to-GDS flow inside the image (no Docker daemon, hours per design)\n                                }"
