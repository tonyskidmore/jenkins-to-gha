pipeline {
  agent any













































  environment {
    APP_NAME = 'open-vsx-org'
    NAMESPACE = 'foundation-internal-webdev-apps'
    IMAGE_NAME = 'ghcr.io/eclipsefdn/openvsx-website'
    CONTAINER_NAME = 'open-vsx-org'
    IMAGE_TAG = sh(
      script: """
        if [ "${env.TAG_NAME}" = "" ]; then
          printf ${env.TAG_NAME}-${env.BUILD_NUMBER}
        else
          printf \$(git rev-parse --short ${env.GIT_COMMIT})-${env.BUILD_NUMBER}
        fi
      """,
      returnStdout: true
    )
  }

  options {
    /* j2gha: buildDiscarder removed */
    timeout(time: 30, unit: 'MINUTES')
  }

  stages {
    stage('Build docker image') {
      agent any


      steps {
        sh '''
          echo docker build --pull -t ${IMAGE_NAME}:${IMAGE_TAG} .  # j2gha-local: no Docker daemon in the harness
        '''
      }
    }

    stage('Push docker image') {
      agent any


      steps {
        withDockerRegistry([credentialsId: 'a56a2346-7fc5-4f91-a624-073197e5f5c8', url: 'https://ghcr.io/']) {
          sh '''
            echo docker push ${IMAGE_NAME}:${IMAGE_TAG}  # j2gha-local: no registry credentials
          '''
        }
      }
    }

    stage('Deploy test') {
      when {
        branch 'test'
      }
      steps {
        container('kubectl') {
          withKubeConfig([credentialsId: 'ci-bot-okd-c1-token', serverUrl: 'https://api.okd-c1.eclipse.org:6443']) {
            sh '''
              echo ./kubernetes/helm-deploy.sh test "${IMAGE_TAG}"  # j2gha-local: no OKD cluster
            '''
          }
        }
      }
    }

    stage('Deploy staging') {
      when {
        branch 'main'
      }
      steps {
        container('kubectl') {
          withKubeConfig([credentialsId: 'ci-bot-okd-c1-token', serverUrl: 'https://api.okd-c1.eclipse.org:6443']) {
            sh '''
              echo ./kubernetes/helm-deploy.sh staging "${IMAGE_TAG}"  # j2gha-local: no OKD cluster
            '''
          }
        }
      }
    }

    stage('Deploy production') {
      when {
        branch 'production'
      }
      steps {
        container('kubectl') {
          withKubeConfig([credentialsId: 'ci-bot-okd-c1-token', serverUrl: 'https://api.okd-c1.eclipse.org:6443']) {
            sh '''
              echo ./kubernetes/helm-deploy.sh production "${IMAGE_TAG}"  # j2gha-local: no OKD cluster
            '''
          }
        }
      }
    }

    stage('Deploy aws-staging') {
      when {
        branch 'aws-main'
      }
      steps {
        container('eks') {
          withCredentials([
            string(credentialsId: 'jenkins-openvsx-aws-key-id',     variable: 'AWS_ACCESS_KEY_ID'),
            string(credentialsId: 'jenkins-openvsx-aws-secret-key', variable: 'AWS_SECRET_ACCESS_KEY'),
          ]) {
            sh '''
              set -e
              export AWS_DEFAULT_REGION=eu-central-1
              export KUBECONFIG="${HOME}/.kube/config"
              echo aws eks update-kubeconfig --name eks-staging-openvsx --region eu-central-1  # j2gha-local: no AWS account
              echo ./kubernetes/helm-deploy.sh aws-staging "${IMAGE_TAG}"  # j2gha-local: no EKS cluster
            '''
          }
        }
      }
    }

    stage('Deploy aws-production') {
      when {
        branch 'aws-production'
      }
      steps {
        container('eks') {
          withCredentials([
            string(credentialsId: 'jenkins-openvsx-aws-key-id',     variable: 'AWS_ACCESS_KEY_ID'),
            string(credentialsId: 'jenkins-openvsx-aws-secret-key', variable: 'AWS_SECRET_ACCESS_KEY'),
          ]) {
            sh '''
              set -e
              export AWS_DEFAULT_REGION=eu-central-1
              echo aws eks update-kubeconfig --name eks-production-openvsx --region eu-central-1  # j2gha-local: no AWS account
              echo ./kubernetes/helm-deploy.sh aws-production "${IMAGE_TAG}"  # j2gha-local: no EKS cluster
            '''
          }
        }
      }
    }
  }

  post {
    failure {
      mail to: 'ci-admin@eclipse.org',
        subject: "[open-vsx.org] Build Failure ${currentBuild.fullDisplayName} - ${env.BRANCH_NAME}",
        mimeType: 'text/html',
        body: "Project: ${env.JOB_NAME}<br/>Build Number: ${env.BUILD_NUMBER}<br/>Build URL: ${env.BUILD_URL}<br/>Console: ${env.BUILD_URL}/console"
    }
    fixed {
      mail to: 'ci-admin@eclipse.org',
        subject: "[open-vsx.org] Back to normal ${currentBuild.fullDisplayName} - ${env.BRANCH_NAME}",
        mimeType: 'text/html',
        body: "Project: ${env.JOB_NAME}<br/>Build Number: ${env.BUILD_NUMBER}<br/>Build URL: ${env.BUILD_URL}<br/>Console: ${env.BUILD_URL}/console"
    }
    cleanup {
      deleteDir() /* clean up workspace */
    }
  }
}

