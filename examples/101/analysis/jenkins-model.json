                        "isLiteral": true,
                        "value": "\n          # j2gha-local: was `make -j4 --output-sync=target dist` (needs Erlang, rebar, Elixir and Sphinx). Builds a\n          # stand-in release tarball named as the real dist target names it from version.mk (the tarball-build form,\n          # without the git sha suffix, so both sides archive the same name). Its configure and Makefile stand in for\n          # CouchDB's: the Test and Package stage runs its configure/make/junit/package commands against them unchanged.\n          . ./version.mk\n          rel=\"apache-couchdb-${vsn_major}.${vsn_minor}.${vsn_patch}\"\n          rm -rf \"$rel\" && mkdir -p \"$rel\"\n          cp LICENSE NOTICE version.mk \"$rel/\"\n          printf '%s\n' '#!/bin/sh' 'echo \"configure (j2gha-local stand-in): $*\"' > \"$rel/configure\"\n          chmod +x \"$rel/configure\"\n          printf '%s\n' \"<testsuite name='couch_tests' tests='2' failures='0' errors='0'>\"             \"<testcase classname='couch_tests' name='basic'/>\" \"<testcase classname='couch_tests' name='config'/>\"             '</testsuite>' > \"$rel/eunit-report.xml\"\n          printf '%s\n' '.RECIPEPREFIX := >'             'all xref elixir elixir-search mango-test weatherreport-test nouveau-test quickjs-test262 build-report:'             '>@echo \"make $@ (j2gha-local stand-in)\"'             'eunit:'             '>mkdir -p .eunit && cp eunit-report.xml .eunit/couch_tests.xml' > \"$rel/Makefile\"\n          tar czf \"$rel.tar.gz\" \"$rel\" && rm -rf \"$rel\"\n          echo \"Done: $rel.tar.gz\"\n        "
