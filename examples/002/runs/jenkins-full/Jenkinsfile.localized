@groovy.transform.Field def scm = [$class: 'GitSCM', branches: [[name: "d076aeb66b68af42c61568676bf29dba9ae3cee8"]], extensions: [[$class: 'CloneOption', shallow: false, noTags: true]], userRemoteConfigs: [[url: "https://github.com/jenkinsci/jenkins.git"]]]
