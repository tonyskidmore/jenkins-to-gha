          "description": "Build even if the image is already present in the repository",
          "required": false,
          "type": "boolean",
          "default": false
        },
        "publish": {
          "description": "Publish built images",
          "required": false,
          "type": "boolean",
          "default": false
        },
        "h2oBranch": {
          "description": "H2O-3 Branch used to load dependencies.",
          "required": false,
          "type": "string",
          "default": "master"
        },
        "noCache": {
          "description": "If set to true, the docker image is built from scratch, with no stages used from the cache.",
          "required": false,
          "type": "boolean",
          "default": true
        }
      }
    }
  },
  "permissions": {
    "contents": "read"
  },
