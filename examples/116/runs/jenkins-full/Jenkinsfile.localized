def label = "jenkins-node-${UUID.randomUUID().toString()}"
podTemplate(label: label, containers: [
    containerTemplate(name: 'maven', image: '086658912680.dkr.ecr.eu-west-1.amazonaws.com/cvs/maven-builder:latest', ttyEnabled: true, command: 'cat'),])
    {
    node('built-in') {
        container('maven'){
		
	    withFolderProperties{
                LBRANCH="${env.BRANCH}".toLowerCase()
            }
            
            APP_ID=""

            stage('checkout') {
                checkout scm
            }

	    stage('Get IPA from AWS S3') {
                withCredentials([usernamePassword(credentialsId: 'jenkins-iam', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {  // j2gha-local: was [[$class: 'AmazonWebServicesCredentialsBinding', accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'jenkins-iam', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']]: the harness fakes only symbol-form bindings (H6), so no 'jenkins-iam' credential would exist; same id and variable names
		   sh "test -n \"\$AWS_ACCESS_KEY_ID\" && echo https://raw.githubusercontent.com/dvsa/cvs-auto-mobile-app-retired/bf150f606a385a8ed5eacc00070a988c675dd815/README.md > ${LBRANCH}.txt"  // j2gha-local: was aws s3 cp s3://dvsa-cvs-mobile-artefacts/files/${LBRANCH}.txt ${LBRANCH}.txt (no aws CLI, no bucket); the pointer file still names a download URL and the bound key is still read
                }
	    }
            
            stage('install ipa in browserstack') {
		sh "curl -sSfLo CVSMobile.ipa `cat ${LBRANCH}.txt`"  // j2gha-local: was wget -O CVSMobile.ipa `cat ${LBRANCH}.txt` (no wget on the Jenkins or JIT-runner image); curl fetches the URL the pointer file names
                withCredentials([usernameColonPassword(credentialsId: 'browserstack-uploader', variable: 'BROWSERSTACK_CREDS')]) {
                   APP_ID=sh(script: 'test -n "$BROWSERSTACK_CREDS" && echo \'{"app_url":"bs://j2gha-local"}\' | jq ".app_url"',returnStdout: true).trim()  // j2gha-local: was curl -u $BROWSERSTACK_CREDS -X POST https://api-cloud.browserstack.com/app-automate/upload -F file=@CVSMobile.ipa | jq ".app_url" (no BrowserStack account); the same JSON shape through the same jq filter, the binding still read
                }
            }
            
            stage ("test") { 
                browserstack('browserstack') {	
                    sh "mvn --batch-mode clean install -DskipTests -DBROWSERSTACK_APP_ID=${APP_ID} -Dorg.slf4j.simpleLogger.log.org.apache.maven.cli.transfer.Slf4jMavenTransferListener=warn"  // j2gha-local: was -PCI-Browserstack without -DskipTests: the profile's Serenity/Appium tests need a BrowserStack device and its serenity:aggregate goal (2.0.20) fails on JDK 21; the project itself builds from Maven Central in about 3.5 minutes
		}
            }
            
            stage("create report"){
                sh 'mkdir -p target/site/serenity && echo "<html><body><h1>DVSA CVS Mobile Automation</h1><p>j2gha-local stand-in for the Serenity report</p></body></html>" > target/site/serenity/index.html'  // j2gha-local: inserted; the report came from the CI-Browserstack profile dropped above, and publishHTML keeps allowMissing: false
                publishHTML (target: [ allowMissing: false,
                 alwaysLinkToLastBuild: false,
                 keepAll: true,
                 reportDir: 'target/site/serenity',
                 reportFiles: 'index.html',
                 reportName: 'DVSA CVS Mobile Automation',
                 reportTitles: 'DVSA CVS Mobile Automation'
               ])
            }
    	}
    }
}

