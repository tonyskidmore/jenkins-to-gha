{
  "name": "j2gha 116: dvsa/cvs-auto-mobile-app-retired Jenkinsfile (j2gha)",
  "on": {
    "push": {
      "branches": [
        "**"
      ]
    },
    "pull_request": null,
    "workflow_dispatch": null
  },
  "permissions": {
    "contents": "read"
  },
  "env": {
    "BRANCH_NAME": "${{ github.head_ref || github.ref_name }}",
    "TAG_NAME": "${{ github.ref_type == 'tag' && github.ref_name || '' }}",
    "CHANGE_ID": "${{ github.event.pull_request.number }}",
    "GIT_COMMIT": "${{ github.sha }}",
    "GIT_BRANCH": "${{ github.head_ref || github.ref_name }}",
    "GIT_URL": "${{ github.server_url }}/${{ github.repository }}.git"
  },
  "defaults": {
    "run": {
      "shell": "bash"
    }
  },
  "jobs": {
    "main": {
      "name": "main",
      "runs-on": "ubuntu-latest",
      "timeout-minutes": 60,
      "steps": [
        {
          "name": "Checkout",
          "uses": "actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
          "with": {
            "persist-credentials": false
          },
          "_j2gha": {
            "kind": "checkout",
            "line": null,
            "trace": false,
            "trace_events": [],
            "role": "checkout"
          }
        },
        {
          "name": "podTemplate (manual migration)",
          "id": "s10",
          "run": "echo \"::warning::Jenkins step 'podTemplate' requires manual migration\"",
          "_j2gha": {
            "kind": "podTemplate",
            "stage": "",
            "line": 2,
            "trace": false
          }
        },
        {
          "name": "withFolderProperties (manual migration)",
          "id": "s1",
          "run": "echo \"::warning::Jenkins step 'withFolderProperties' requires manual migration\"",
          "_j2gha": {
            "kind": "withFolderProperties",
            "stage": "",
            "line": 8,
            "trace": true
          }
        },
        {
          "name": "checkout: checkout",
          "id": "s2",
          "uses": "actions/checkout@11d5960a326750d5838078e36cf38b85af677262",
          "with": {
            "persist-credentials": false
          },
          "_j2gha": {
            "kind": "checkout",
            "stage": "checkout",
            "line": 15,
            "trace": true
          }
        },
        {
          "name": "Get IPA from AWS S3: test -n \"$AWS_ACCESS_KEY_ID\" && echo https://raw.githubusercontent.com",
          "id": "s3",
          "run": "test -n \"$AWS_ACCESS_KEY_ID\" && echo https://raw.githubusercontent.com/dvsa/cvs-auto-mobile-app-retired/bf150f606a385a8ed5eacc00070a988c675dd815/README.md > ${LBRANCH}.txt",
          "env": {
            "AWS_ACCESS_KEY_ID": "${{ secrets.JENKINS_IAM_USR }}",
            "AWS_SECRET_ACCESS_KEY": "${{ secrets.JENKINS_IAM_PSW }}"
          },
          "_j2gha": {
            "kind": "sh",
            "stage": "Get IPA from AWS S3",
            "line": 20,
            "trace": true
          }
        },
        {
          "name": "install ipa in browserstack: curl -sSfLo CVSMobile.ipa `cat ${LBRANCH}.txt`",
          "id": "s4",
          "run": "curl -sSfLo CVSMobile.ipa `cat ${LBRANCH}.txt`",
          "_j2gha": {
            "kind": "sh",
            "stage": "install ipa in browserstack",
            "line": 25,
            "trace": true
          }
        },
        {
          "name": "install ipa in browserstack: test -n \"$BROWSERSTACK_CREDS\" && echo '{\"app_url\":\"bs://j2gha-local\"}'",
          "id": "s5",
          "run": "test -n \"$BROWSERSTACK_CREDS\" && echo '{\"app_url\":\"bs://j2gha-local\"}' | jq \".app_url\"",
          "env": {
            "BROWSERSTACK_CREDS": "${{ secrets.BROWSERSTACK_UPLOADER }}"
          },
          "_j2gha": {
            "kind": "sh",
            "stage": "install ipa in browserstack",
            "line": 27,
            "trace": true
          }
        },
        {
          "name": "test: browserstack (manual migration)",
          "id": "s7",
          "run": "echo \"::warning::Jenkins step 'browserstack' requires manual migration\"",
          "_j2gha": {
            "kind": "browserstack",
            "stage": "test",
            "line": 32,
            "trace": true
          }
        },
        {
          "name": "test: mvn --batch-mode clean install -DskipTests -DBROWSERSTACK_APP_ID=${APP",
          "id": "s6",
          "run": "mvn --batch-mode clean install -DskipTests -DBROWSERSTACK_APP_ID=${APP_ID} -Dorg.slf4j.simpleLogger.log.org.apache.maven.cli.transfer.Slf4jMavenTransferListener=warn",
          "_j2gha": {
            "kind": "sh",
            "stage": "test",
            "line": 33,
            "trace": true
          }
        },
        {
          "name": "create report: mkdir -p target/site/serenity && echo \"<html><body><h1>DVSA CVS Mobile",
          "id": "s8",
          "run": "mkdir -p target/site/serenity && echo \"<html><body><h1>DVSA CVS Mobile Automation</h1><p>j2gha-local stand-in for the Serenity report</p></body></html>\" > target/site/serenity/index.html",
          "_j2gha": {
            "kind": "sh",
            "stage": "create report",
            "line": 38,
            "trace": true
          }
        },
        {
          "name": "create report: publish HTML report",
          "id": "s9",
          "if": "always()",
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
          "with": {
            "name": "html-report-9",
            "path": "target/site/serenity"
          },
          "_j2gha": {
            "kind": "publishHTML",
            "stage": "create report",
            "line": 39,
            "trace": true
          }
        }
      ]
    }
  }
}
