@groovy.transform.Field def scm = [$class: 'GitSCM', branches: [[name: "e7e9913a6090bd18f16fb85eb98b7b5f0dbfa87c"]], extensions: [[$class: 'CloneOption', shallow: false, noTags: true]], userRemoteConfigs: [[url: "https://github.com/dvsa/olcs-ci.git"]]]
