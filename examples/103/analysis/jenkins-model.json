                                "value": "\n                tar czvf \"${ARTIFACT_FILENAME}_${VERSION}.tar.gz\" usr/share\n                # j2gha-local: was `fpm -s tar -t deb -n robot-descriptions -v ${VERSION} -a all --vendor ... --maintainer ...\n                # \"${ARTIFACT_FILENAME}_${VERSION}.tar.gz\"` (fpm is not installed); writes the .deb under the name fpm would\n                # have used, so the mv below renames it to the .ipk the stage prints unchanged\n                tar czf \"${ARTIFACT_FILENAME}_${VERSION}_all.deb\" \"${ARTIFACT_FILENAME}_${VERSION}.tar.gz\"\n                # Rename .deb to .ipk for opkg-compatible publishing via fePublishOpkg\n                mv \"${ARTIFACT_FILENAME}_${VERSION}_all.deb\" \"${ARTIFACT_FILENAME}_${VERSION}_all.ipk\"\n                printf \"%s archive created.\nversion: %s\nsha1sum: %s\n\" \"${ARTIFACT_FILENAME}\" \"${VERSION}\" \"$(sha1sum \"${ARTIFACT_FILENAME}_${VERSION}_all.ipk\")\"\n              "
                              }
                            }
                          ]
                        },
                        {
                          "name": "archiveArtifacts",
                          "arguments": [
                            {
                              "key": "artifacts",
                              "value": {
                                "isLiteral": true,
                                "value": "*.tar.gz"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
